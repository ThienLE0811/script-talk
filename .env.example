# Copy this file to .env.local and fill in your own values. .env.local is git-ignored.
# On Vercel, set the same variables in Project Settings → Environment Variables.

# Access code typed on /login. Required in production (without it the deployed app stays locked).
# Leave empty locally to skip the login screen during development. Use a long random phrase.
APP_ACCESS_CODE=

# Optional: secret for signing the login cookie (defaults to APP_ACCESS_CODE).
# AUTH_SECRET=

# MongoDB connection string for saved scripts (MongoDB Atlas free M0 cluster works).
MONGODB_URI=
# Optional: database name (default: scripttalk).
# MONGODB_DB=scripttalk

# Gemini API key for the "natural conversation" mode (create one at https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional: override the models. The fallback is used when the main model is overloaded,
# out of quota or too slow. Defaults: gemini-3.6-flash / gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
