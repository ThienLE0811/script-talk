# Copy this file to .env.local and fill in your own values. .env.local is git-ignored.

# Gemini API key for the "natural conversation" mode (create one at https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional: override the models. The fallback is used when the main model is overloaded,
# out of quota or too slow. Defaults: gemini-3.6-flash / gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
